<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Apex" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas_background</item>
        <item name="android:statusBarColor">@color/canvas_background</item>
        <item name="android:navigationBarColor">@color/canvas_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Android 12+ SplashScreen overrides: seamless beige start without icon flicker -->
        <item name="android:windowSplashScreenBackground">@color/canvas_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
